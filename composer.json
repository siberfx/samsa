{
    "name": "siberfx/samsa",
    "description": "Kafka's model of topics, partitions, offsets and consumer groups inside Laravel. Pure PHP, no broker required.",
    "keywords": [
        "laravel",
        "kafka",
        "event-log",
        "event-sourcing",
        "streaming",
        "consumer-groups",
        "partitions",
        "nats",
        "jetstream",
        "redis-streams"
    ],
    "homepage": "https://github.com/siberfx/samsa",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Siberfx",
            "email": "info@siberfx.com",
            "homepage": "https://siberfx.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "symfony/uid": "^7.2|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0",
        "symfony/process": "^7.2|^8.0"
    },
    "suggest": {
        "basis-company/nats": "Required for the NATS JetStream driver (v0.4).",
        "ext-pcntl": "Required for graceful shutdown of workers on SIGTERM/SIGINT.",
        "ext-redis": "Required for the Redis Streams driver (v0.5), or use predis/predis.",
        "siberfx/message-bus": "Use Samsa as a message-bus transport (v0.3)."
    },
    "autoload": {
        "psr-4": {
            "Siberfx\\Samsa\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Siberfx\\Samsa\\Tests\\": "tests/"
        },
        "files": [
            "tests/Fixtures/Handlers.php"
        ]
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Siberfx\\Samsa\\SamsaServiceProvider"
            ],
            "aliases": {
                "Samsa": "Siberfx\\Samsa\\Facades\\Samsa"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
